{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OwnVoice profile",
  "type": "object",
  "required": [
    "schema_version",
    "basis",
    "preferences"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "basis": {
      "enum": [
        "samples",
        "preferences",
        "mixed",
        "generic"
      ]
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "zh": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 12
            },
            "en": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 12
            }
          }
        },
        "research": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "zh": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 12
            },
            "en": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 12
            }
          }
        },
        "email": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "zh": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 12
            },
            "en": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 12
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
